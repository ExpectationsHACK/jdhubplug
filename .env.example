# JDHub environment variables. Copy to .env.local for local development.
# On Vercel: Project → Settings → Environment Variables.

# --- Admin (required in production) ---
# Owner password for /admin. Staff accounts are created inside the admin.
ADMIN_PASSWORD=
# Long random string used to sign admin sessions (e.g. `openssl rand -hex 32`).
AUTH_SECRET=
# Optional: owner email, so the owner can also sign in with email + password.
ADMIN_EMAIL=

# --- Storage (required in production) ---
# Vercel → Storage → Upstash for Redis (Marketplace) adds these automatically.
# Without them the store runs in memory and admin edits/orders are NOT saved.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# (UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN are accepted too.)

# --- Payments (optional) ---
# Paystack keys enable card/bank checkout. Without them, checkout offers bank
# transfer / WhatsApp payment and the admin marks orders paid.
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# --- Image uploads (optional) ---
# Vercel → Storage → Blob adds this. Enables uploading product photos in the admin.
BLOB_READ_WRITE_TOKEN=

# --- Cron (recommended) ---
# Vercel sends this as a Bearer token to /api/cron/* so only Vercel can trigger them.
CRON_SECRET=

# --- Site ---
# Public URL, used for offer links, sitemap and Paystack callbacks.
NEXT_PUBLIC_SITE_URL=https://jdhubplug.vercel.app
