# JDHub environment variables. Copy to .env.local for local development.
# On Vercel: Project → Settings → Environment Variables.

# --- Admin (required in production) ---
# Owner password for /admin. Staff accounts are created inside the admin.
ADMIN_PASSWORD=
# Long random string used to sign admin sessions (e.g. `openssl rand -hex 32`).
AUTH_SECRET=
# Optional: owner email, so the owner can also sign in with email + password.
ADMIN_EMAIL=

# --- Storage (required in production) ---
# Vercel → Storage → Upstash for Redis (Marketplace) adds these automatically.
# Without them the store runs in memory and admin edits/orders are NOT saved.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# (UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN are accepted too.)

# --- Customer sign-in (one-time codes) ---
# Configure at least one channel in production, or checkout falls back to guest mode.
# SMS via Termii (https://termii.com): API key and an approved sender ID.
TERMII_API_KEY=
TERMII_SENDER_ID=JDHub
# "dnd" (default) also reaches numbers on the do-not-disturb list; "generic" is cheaper.
TERMII_CHANNEL=dnd
# Email via Resend (https://resend.com): API key and a verified sender.
RESEND_API_KEY=
EMAIL_FROM=JDHub <hello@your-domain.ng>

# --- Error tracking: Sentry (optional) ---
# From Sentry → Project settings → Client keys (DSN).
NEXT_PUBLIC_SENTRY_DSN=
# Source-map upload during Vercel builds (Sentry → Settings → Auth tokens).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Fraction of requests traced for performance (0–1). Default 0.1.
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Analytics: PostHog (optional) ---
# From PostHog → Project settings. Host is https://us.i.posthog.com or https://eu.i.posthog.com.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Payments (optional) ---
# Paystack keys enable card/bank checkout. Without them, checkout offers bank
# transfer / WhatsApp payment and the admin marks orders paid.
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# --- Image uploads (optional) ---
# Vercel → Storage → Blob adds this. Enables uploading product photos in the admin.
BLOB_READ_WRITE_TOKEN=

# --- Cron (recommended) ---
# Vercel sends this as a Bearer token to /api/cron/* so only Vercel can trigger them.
CRON_SECRET=

# --- Site ---
# Public URL, used for offer links, sitemap and Paystack callbacks.
NEXT_PUBLIC_SITE_URL=https://jdhubplug.vercel.app
